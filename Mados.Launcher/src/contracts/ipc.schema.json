{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spacestation14.com/mados-launcher/ipc/v1.schema.json",
  "title": "Mados Launcher worker IPC v1",
  "oneOf": [
    {
      "$comment": "request",
      "type": "object",
      "required": ["v", "id", "method"],
      "properties": {
        "v": { "const": 1 },
        "id": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "params": {}
      },
      "additionalProperties": false
    },
    {
      "$comment": "response",
      "type": "object",
      "required": ["v", "id"],
      "properties": {
        "v": { "const": 1 },
        "id": { "type": ["string", "null"] },
        "result": {},
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "details": {} },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "$comment": "event",
      "type": "object",
      "required": ["v", "event", "data"],
      "properties": { "v": { "const": 1 }, "event": { "type": "string" }, "data": {} },
      "additionalProperties": false
    }
  ],
  "x-methods": {
    "app": ["getState", "getVersion", "openDeepLink", "shutdown"],
    "auth": ["getAccounts", "login", "logout", "switchAccount"],
    "servers": ["list", "refresh", "info", "connect"],
    "favorites": ["list", "add", "remove"],
    "playtime": ["getSummary", "clear"],
    "recentConnections": ["list"],
    "serverNotes": ["list", "upsert", "remove"],
    "monitoring": ["getFavorites", "refresh"],
    "launchProfiles": ["list", "create", "update", "remove", "use"],
    "notifications": ["list", "markRead", "clear"],
    "tools": ["cdn.inspect", "cdn.import", "cdn.cancel"],
    "localServers": ["list", "create", "update", "remove", "start", "stop", "restart", "getStatus", "getConfig", "saveConfig", "testPort", "openFolder", "openLog", "backups", "rollback"],
    "news": ["list"],
    "settings": ["get", "update"],
    "content": ["openBundle"],
    "updates": ["getStatus", "start"],
    "connection": ["cancel", "confirmPrivacyPolicy"]
  },
  "x-shell-channels": ["get-update-state", "check-for-updates", "download-update", "install-update"],
  "x-events": [
    "shell.updateState",
    "app.ready", "app.startup", "app.error", "auth.changed", "servers.updated", "connection.started",
    "connection.progress", "connection.completed", "connection.failed", "update.progress",
    "update.completed", "deepLink.received", "playtime.updated", "recentConnections.updated", "presence.updated", "settings.changed", "monitoring.updated", "monitoring.failed", "notification.created", "launchProfiles.updated", "cdn.progress", "cdn.completed", "cdn.failed", "localServer.status", "localServer.log", "localServer.configChanged", "localServer.error"
  ],
  "x-event-payloads": {
    "shell.updateState": {
      "description": "Electron-owned update state; installation only after an explicit user action. Monotonic revision prevents stale renderer snapshots.",
      "type": "object",
      "required": ["status", "currentVersion", "revision"],
      "properties": {
        "status": { "enum": ["idle", "checking", "available", "downloading", "downloaded", "error", "disabled"] },
        "currentVersion": { "type": "string" },
        "revision": { "type": "integer", "minimum": 0 },
        "version": { "type": "string" },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "message": { "type": "string" },
        "checkedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "connection.started": {
      "description": "A server connection supplies a sanitized address and optional display name. Bundles supply a filename and contentBundle instead.",
      "type": "object",
      "properties": {
        "address": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "path": { "type": "string" },
        "contentBundle": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "servers.updated": {
      "description": "Also returned by servers.list and servers.refresh. Lists are usable while refreshing is true. Clients ignore revisions older than or equal to their current snapshot. Stale marks a retained list when all hubs fail.",
      "type": "object",
      "required": ["servers", "failedHubs", "partialError"],
      "properties": {
        "servers": { "type": "array", "items": { "type": "object" } },
        "failedHubs": { "type": "array", "items": { "type": "string" } },
        "partialError": { "type": "boolean" },
        "revision": { "type": "integer", "minimum": 0 },
        "refreshing": { "type": "boolean" },
        "stale": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "app.startup": {
      "type": "object",
      "required": ["stage"],
      "properties": {
        "stage": { "enum": ["starting-worker", "checking-data", "loading-ui", "ready"] },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "presence.updated": {
      "type": "object",
      "required": ["state", "enabled", "showNickname"],
      "properties": {
        "state": { "enum": ["launcher", "connecting", "updating", "playing"] },
        "enabled": { "type": "boolean" },
        "showNickname": { "type": "boolean" },
        "accountName": { "type": ["string", "null"] },
        "serverName": { "type": ["string", "null"] },
        "address": { "type": ["string", "null"] },
        "playerCount": { "type": ["integer", "null"] },
        "softMaxPlayerCount": { "type": ["integer", "null"] },
        "pingMs": { "type": ["number", "null"] },
        "map": { "type": ["string", "null"] },
        "mode": { "type": ["string", "null"] },
        "startedAt": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "settings.changed": {
      "type": "object",
      "properties": {
        "discord": {
          "type": "object",
          "required": ["enabled", "showNickname"],
          "properties": {
            "enabled": { "type": "boolean" },
            "showNickname": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "favoriteAvailabilityNotifications": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "monitoring.updated": {
      "type": "object",
      "required": ["accountId", "favorites"],
      "properties": { "accountId": { "type": "string" }, "favorites": { "type": "array" } },
      "additionalProperties": false
    },
    "monitoring.failed": {
      "type": "object",
      "required": ["accountId", "message"],
      "properties": { "accountId": { "type": "string" }, "message": { "type": "string" }, "favorites": { "type": ["array", "null"] } },
      "additionalProperties": false
    },
    "notification.created": {
      "type": "object",
      "required": ["id", "kind", "title", "message", "createdAt", "readAt"],
      "properties": { "id": { "type": "string" }, "kind": { "type": "string" }, "title": { "type": "string" }, "message": { "type": "string" }, "createdAt": { "type": "string" }, "readAt": { "type": ["string", "null"] } },
      "additionalProperties": false
    },
    "launchProfiles.updated": {
      "type": "object",
      "required": ["accountId"],
      "properties": { "accountId": { "type": "string" } },
      "additionalProperties": false
    },
    "recentConnections.updated": {
      "type": "object",
      "required": ["accountId"],
      "properties": {
        "accountId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "cdn.progress": {
      "type": "object",
      "required": ["operationId", "stage"],
      "properties": {
        "operationId": { "type": "string" },
        "stage": { "enum": ["inspecting", "downloading", "extracting", "validating", "completed", "failed", "cancelled"] },
        "percent": { "type": ["number", "null"] },
        "downloadedBytes": { "type": ["integer", "null"] },
        "totalBytes": { "type": ["integer", "null"] },
        "message": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "cdn.completed": {
      "type": "object",
      "required": ["operationId", "profileId"],
      "properties": {
        "operationId": { "type": "string" },
        "profileId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "cdn.failed": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "operationId": { "type": "string" },
        "code": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "localServer.status": {
      "type": "object",
      "required": ["profileId", "status", "port"],
      "properties": {
        "profileId": { "type": ["string", "null"] },
        "status": { "enum": ["idle", "downloading", "extracting", "ready", "starting", "running", "stopping", "stopped", "error"] },
        "pid": { "type": ["integer", "null"] },
        "address": { "type": "string" },
        "port": { "type": "integer" },
        "readyAt": { "type": ["string", "null"] },
        "lastError": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "localServer.log": {
      "type": "object",
      "required": ["profileId", "timestamp", "stream", "line"],
      "properties": {
        "profileId": { "type": "string" },
        "timestamp": { "type": "string" },
        "stream": { "enum": ["stdout", "stderr"] },
        "line": { "type": "string" }
      },
      "additionalProperties": false
    },
    "localServer.configChanged": {
      "type": "object",
      "required": ["profileId"],
      "properties": { "profileId": { "type": "string" } },
      "additionalProperties": false
    },
    "localServer.error": {
      "type": "object",
      "required": ["profileId", "message"],
      "properties": {
        "profileId": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
