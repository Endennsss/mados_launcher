{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mados.space/schemas/installer-v1.json",
  "title": "Mados Installer IPC v1",
  "type": "object",
  "properties": {
    "method": {
      "type": "string",
      "enum": ["release.check", "install.chooseDirectory", "install.getDefaultDirectory", "install.start", "install.cancel", "install.openDirectory", "app.quit"]
    },
    "event": {
      "type": "string",
      "enum": ["installer.stage", "installer.progress", "installer.error"]
    },
    "stage": {
      "type": "string",
      "enum": ["checking", "ready", "downloading", "extracting", "installing", "launching", "completed", "error"]
    },
    "directory": { "type": "string", "minLength": 1 },
    "progress": {
      "type": "object",
      "properties": {
        "receivedBytes": { "type": "integer", "minimum": 0 },
        "totalBytes": { "type": ["integer", "null"], "minimum": 1 },
        "percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      },
      "required": ["receivedBytes", "totalBytes", "percent"],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      },
      "required": ["code", "message", "retryable"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
